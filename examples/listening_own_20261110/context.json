  "targets": {
    "1-101404-A-34.wav": {
      "tag": "a competing event takes first place",
      "summary": "Opening a can while an alarm clock rings. Each model names the can when it is alone. At +10 and +5 dB white noise breaks the SVM and CNN but not CLAP, while the competing event takes first place from both the CNN and CLAP at every level."
    },
    "5-210612-A-37.wav": {
      "tag": "all three models hold",
      "summary": "An alarm clock rings while a can is opened, using different source recordings from the can-opening example. All three models keep the alarm clock under both competing events at every level. A competing event does not always win."
    },
    "4-161100-A-47.wav": {
      "tag": "the target slips to second place",
      "summary": "An aircraft passes while church bells ring. At +10 dB CLAP still answers airplane. At +5 dB the bells take first place and airplane drops to second, while the SVM and CNN keep airplane."
    },
    "1-100032-A-0.wav": {
      "tag": "two models are already wrong on the clean clip",
      "summary": "A dog bark. The SVM and CNN mislabel this clip even without interference, so their mixture predictions say little about interference here. CLAP is right on the clean clip and is captured by the competing event at every level."
    }
  },
