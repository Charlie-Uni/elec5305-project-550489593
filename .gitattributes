# Audit records hash the exact CSV bytes generated by Python's CSV writer.
# Preserve them across Git checkout instead of normalising CRLF to LF.
*.csv -text whitespace=cr-at-eol
# Matplotlib SVG paths contain deliberate trailing spaces; preserve audited bytes.
*.svg -text -whitespace
results/**/export_compliance.txt -whitespace

# Keep numerical and media artifacts byte-identical as well.
*.npz binary
*.npy binary
*.wav binary
*.pdf binary
*.png binary
